package layout

import "github.com/nelsonmarro/go-stripe/templates/components/sidebar"
import "github.com/nelsonmarro/go-stripe/templates/components/icon"
import "github.com/nelsonmarro/go-stripe/templates/components/dropdown"
import "github.com/nelsonmarro/go-stripe/templates/components/avatar"
import "github.com/nelsonmarro/go-stripe/utils"

templ SidebarNavigation(pageTitle string, collapsed bool) {
	@sidebar.Sidebar(sidebar.Props{
		ID:          "sidebar-component",
		Collapsed:   collapsed,
		Collapsible: sidebar.CollapsibleIcon,
		Variant:     sidebar.VariantFloating,
	}) {
		@sidebar.Header() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@sidebar.MenuButton(sidebar.MenuButtonProps{
						Href:  "/",
						Size:  sidebar.MenuButtonSizeLg,
						Class: "data-[tui-sidebar-state=open]:bg-sidebar-accent data-[tui-sidebar-state=open]:text-sidebar-accent-foreground",
					}) {
						<div class="flex aspect-square size-8 items-center justify-center rounded-lg bg-primary text-primary-foreground">
							@icon.Command(icon.Props{Class: "size-4"})
						</div>
						<div class="grid flex-1 text-left text-sm leading-tight">
							<span class="truncate font-semibold">Go Stripe</span>
							<span class="truncate text-xs">Enterprise</span>
						</div>
					}
				}
			}
		}
		@sidebar.Content() {
			@sidebar.Group() {
				@sidebar.GroupLabel() {
					Platform
				}
				@sidebar.Menu() {
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							IsActive: pageTitle == "Virtual Terminal",
							Attributes: templ.Attributes{
								"data-on:click": "@get('/virtual-terminal')",
							}}) {
							@icon.CreditCard(icon.Props{Class: "size-4"})
							<span>Virtual Terminal</span>
						}
					}
					@sidebar.MenuItem() {
						@sidebar.MenuButton(sidebar.MenuButtonProps{
							IsActive: pageTitle == "Buy Page",
							Attributes: templ.Attributes{
								"data-on:click": "@get('/buy-page')",
							}}) {
							@icon.ShoppingCart(icon.Props{Class: "size-4"})
							<span>Buy Page</span>
						}
					}
				}
			}
		}
		@sidebar.Footer() {
			@sidebar.Menu() {
				@sidebar.MenuItem() {
					@dropdown.Dropdown() {
						@dropdown.Trigger() {
							@sidebar.MenuButton(sidebar.MenuButtonProps{
								Size: sidebar.MenuButtonSizeLg,
							}) {
								@avatar.Avatar(avatar.Props{Class: "size-8 rounded-lg"}) {
									@avatar.Image(avatar.ImageProps{
										Src: "https://github.com/shadcn.png",
									})
									@avatar.Fallback() {
										NM
									}
								}
								<div class="grid flex-1 text-left text-sm leading-tight">
									<span class="truncate font-medium">Nelson Marro</span>
									<span class="truncate text-xs">nelson@example.com</span>
								</div>
								@icon.ChevronsUpDown(icon.Props{Class: "ml-auto size-4"})
							}
						}
						@dropdown.Content(dropdown.ContentProps{
							Class:     "w-[--radix-dropdown-menu-trigger-width] min-w-56 rounded-lg",
							Placement: dropdown.PlacementTopStart,
						}) {
							@dropdown.Label() {
								My Account
							}
							@dropdown.Separator()
							@dropdown.Item() {
								<span class="flex items-center">
									@icon.User(icon.Props{Size: 16, Class: "mr-2"})
									Profile
								</span>
							}
							@dropdown.Item() {
								<span class="flex items-center">
									@icon.Settings(icon.Props{Size: 16, Class: "mr-2"})
									Settings
								</span>
							}
							@dropdown.Separator()
							@dropdown.Item() {
								<span class="flex items-center">
									@icon.LogOut(icon.Props{Size: 16, Class: "mr-2"})
									Log out
								</span>
							}
						}
					}
				}
			}
		}
	}
}

templ PageHeader(pageTitle string) {
	<header id="page-header" class="flex h-14 items-center gap-2 border-b bg-background px-4">
		@sidebar.Trigger(sidebar.TriggerProps{Target: "sidebar-component"})
		@sidebar.Separator(sidebar.SeparatorProps{Class: "mr-2 h-4", Attributes: templ.Attributes{"orientation": "vertical"}})
		<div class="flex items-center gap-2 font-medium">
			<span class="text-muted-foreground">App</span>
			<span class="text-muted-foreground">/</span>
			<span>{ pageTitle }</span>
		</div>
	</header>
}

templ ContentWrapper(contents templ.Component) {
	<div id="content" class="max-w-4xl mx-auto">
		@contents
	</div>
}

templ Shell(pageTitle string) {
	{{
		collapsed := false
		if val := ctx.Value(utils.SidebarCollapsedKey); val != nil {
			if b, ok := val.(bool); ok {
				collapsed = b
			}
		}
	}}
	@sidebar.Layout(sidebar.LayoutProps{
		ID:    "sidebar-component",
		Class: "h-screen",
	}) {
		@SidebarNavigation(pageTitle, collapsed)
		@sidebar.Inset() {
			@PageHeader(pageTitle)
			<main class="flex-1 overflow-auto p-4">
				<div id="content" class="max-w-4xl mx-auto">
					{ children... }
				</div>
			</main>
		}
	}
}
